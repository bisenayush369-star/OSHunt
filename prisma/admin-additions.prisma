// OPTIONAL: a shared answer cache for llmRouter.ts.
//
// Add this model to prisma/backend/schema.prisma, then run:
//   npx prisma db push --schema=prisma/backend/schema.prisma
// (build / postinstall already run `prisma generate`, so the client gets the new model.)
//
// The router looks for `prisma.llmCache` at run time. Without this model it keeps answers in memory only
// (lost on restart, not shared between server instances) and prints one line saying so. With it, answers are
// shared by every instance and survive restarts. Nothing is cached unless a call passes `cacheTtlSeconds`.
// Old rows are deleted by the router (at most once an hour); you do not need a cron job.

model LlmCache {
  key        String   @id
  text       String   @db.Text
  tokensUsed Int
  provider   String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}
