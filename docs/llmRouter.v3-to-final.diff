 export const KNOWN_LLM_PROVIDERS: readonly string[] = [...Object.keys(OPENAI_COMPATIBLE_PROVIDERS), "GEMINI", "COHERE", "ANTHROPIC"];
 const KNOWN_PROVIDERS = KNOWN_LLM_PROVIDERS;
 
+// --- Tool calls: who can receive them ---------------------------------------------------------------------
+// callOpenAICompatible() and callAnthropic() send `tools`; callGemini() and callCohere() do not, so an agent step
+// sent there would come back as plain text. Tool requests therefore skip those two. A provider that answers a
+// tool request with HTTP 400/422 is kept out of tool requests for an hour but stays in for plain chat (its 400 is
+// not "broken key"). LLM_TOOL_PROVIDERS (comma list) replaces the built-in rule when you know better.
+const NO_TOOLS_MS = 60 * 60_000;
+const toolBlockedUntil = ((globalThis as unknown as { __llmNoTools?: Map<string, number> }).__llmNoTools ??= new Map<string, number>());
+
+function supportsTools(name: string): boolean {
+  const override = process.env.LLM_TOOL_PROVIDERS?.trim();
+  if (override) return override.split(",").map((item) => normalizeProviderName(item)).includes(name);
+  if (name === "GEMINI" || name === "COHERE") return false;
+  const until = toolBlockedUntil.get(name);
+  return !(until && until > Date.now());
+}
+
+function markNoTools(provider: string, status: number) {
+  if (toolBlockedUntil.has(provider) && (toolBlockedUntil.get(provider) ?? 0) > Date.now()) return;
+  toolBlockedUntil.set(provider, Date.now() + NO_TOOLS_MS);
+  console.warn(`[LLM] ℹ ${provider} rejected a tool request (HTTP ${status}); it is skipped for tool requests for ${NO_TOOLS_MS / 60000} min and still used for plain chat.`);
+}
+
+// --- Limit e-mails: one per provider per level per 6 hours (it used to send one on EVERY call above 80%) -----
+const ALERT_EVERY_MS = 6 * 3_600_000;
+const limitAlerts = ((globalThis as unknown as { __llmAlerts?: Map<string, { at: number; level: 80 | 100 }> }).__llmAlerts ??= new Map<string, { at: number; level: 80 | 100 }>());
+
+function shouldSendLimitAlert(name: string, used: number, max: number): boolean {
+  if (!(max > 0) || used / max < 0.8) return false;
+  const level: 80 | 100 = used >= max ? 100 : 80;
+  const previous = limitAlerts.get(name);
+  const now = Date.now();
+  if (previous && previous.level >= level && now - previous.at < ALERT_EVERY_MS) return false;
+  limitAlerts.set(name, { at: now, level });
+  return true;
+}
+
